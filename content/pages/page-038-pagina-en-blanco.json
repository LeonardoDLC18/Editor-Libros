              "title": "Pasos:",
              "items": [
                {
                  "id": "step-30840e14-e128-48b0-8088-13e76a7afb40",
                  "content": [
                    {
                      "text": "Crea un documento en Word y agrega el encabezado: Guía turística de Arequipa."
                    }
                  ]
                },
                {
                  "id": "step-dd37e91c-4298-4fc9-a158-7d42bbf1ade2",
                  "content": [
                    {
                      "text": "Escribe el "
                    },
                    {
                      "text": "título ",
                      "highlight": true
                    },
                    {
                      "text": "principal: GUÍA TURÍSTICA DE AREQUIPA."
                    }
                  ]
                },
                {
                  "id": "step-47e4fbf7-d56e-4e59-b98d-4065e9eff85b",
                  "content": [
                    {
                      "text": "Agrega los tres lugares turísticos con una breve descripción de cada uno."
                    }
                  ]
                },
                {
                  "id": "step-26dd9a6c-af65-42ec-94fe-cb638a3bbe62",
                  "content": [
                    {
                      "text": "Da formato: centra los títulos, aplica negrita e inserta las imágenes correspondientes."
                    }
                  ]
                },
                {
                  "id": "step-8b36da92-1f95-4b8a-9615-b7ec8ab1b703",
                  "content": [
                    {
                      "text": "Finaliza: coloca tu nombre en el"
                    },
                    {
                      "text": " pie de página",
                      "highlight": true
                    },
                    {
                      "text": " y personaliza el diseño."
                    }
                  ]
                }
              ]
            }
