                {
                  "id": "item-ef046201-a186-4c67-91a9-69d91f6933ab",
                  "content": [
                    {
                      "text": "Escribe el título: Mi lugar favorito."
                    }
                  ]
                },
                {
                  "id": "item-71be5ff6-a6cd-49b3-866a-f4e2e861c6b2",
                  "content": [
                    {
                      "text": "Selecciona el título y aplícale la "
                    },
                    {
                      "text": "alineación centrada",
                      "highlight": true
                    },
                    {
                      "text": "."
                    }
                  ]
                },
                {
                  "id": "item-242b40dc-8f56-48f2-be37-d095e3189db5",
                  "content": [
                    {
                      "text": "Escribe un párrafo breve sobre ese lugar."
                    }
                  ]
                },
                {
                  "id": "item-fccf30ce-aed5-472d-8c69-70ae2a41229d",
                  "content": [
                    {
                      "text": "Selecciona el párrafo y aplica la "
                    },
                    {
                      "text": "alineación justificada",
                      "highlight": true
                    },
                    {
                      "text": "."
                    }
                  ]
                }
              ]
            }
