              "items": [
                {
                  "id": "item-b3b8602b-2fcb-45fc-9f39-d7644752462a",
                  "content": [
                    {
                      "text": "Haz "
                    },
                    {
                      "text": "doble clic",
                      "highlight": true
                    },
                    {
                      "text": " en la parte superior o inferior del documento para activar el encabezado o el pie de página."
                    }
                  ]
                },
                {
                  "id": "item-0aed7b76-1335-40cf-bd2c-2a7438ec0d02",
                  "content": [
                    {
                      "text": "Escribe o modifica el texto del encabezado o del pie de página."
                    }
                  ]
                },
                {
                  "id": "item-a2d84523-6348-4050-afca-a982305292ae",
                  "content": [
                    {
                      "text": "Cuando termines, haz clic en “Cerrar encabezado y pie de página” o haz "
                    },
                    {
                      "text": "doble clic",
                      "highlight": true
                    },
                    {
                      "text": " fuera del área de edición."
                    }
                  ]
                }
              ]
            }
          ]
        },
