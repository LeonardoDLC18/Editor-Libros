          "blocks": [
            {
              "id": "steps-26b02370-e013-4ac2-a3df-30d9292b2e67",
              "type": "steps",
              "title": "Pasos:",
              "items": [
                {
                  "id": "step-eea04d66-282f-437c-9de9-44d52bf7ae00",
                  "content": [
                    {
                      "text": "Abrir la pestaña Insertar:",
                      "highlight": true
                    },
                    {
                      "text": " En la cinta de opciones de Word, haz clic en la pestaña Insertar."
                    }
                  ]
                },
                {
                  "id": "step-dd0b3aea-bbd5-44a4-9211-a036c5414b85",
                  "content": [
                    {
                      "text": "Agregar el encabezado o pie de página:",
                      "highlight": true
                    },
                    {
                      "text": " En el grupo Encabezado y pie de página, selecciona Encabezado para escribir en la parte superior del documento o Pie de página para escribir en la parte inferior."
                    }
                  ]
                },
                {
                  "id": "step-e3d9b9f8-717e-4527-bedd-b8cbd765400c",
                  "content": [
                    {
                      "text": "Insertar el número de página:",
                      "highlight": true
                    },
                    {
                      "text": " Haz clic en Número de página y elige dónde deseas colocarlo, por ejemplo, Final de página."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "col-276d8e28-0a19-42c5-aee2-3dae493af8f7",
