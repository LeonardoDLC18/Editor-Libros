              "items": [
                {
                  "id": "item-3acd4d7e-edd3-4304-abb3-1a142108d282",
                  "content": [
                    {
                      "text": "Seleccionar el texto:",
                      "bold": true
                    },
                    {
                      "text": " Abre tu documento de Word y "
                    },
                    {
                      "text": "selecciona",
                      "highlight": true
                    },
                    {
                      "text": " el párrafo que deseas alinear."
                    }
                  ]
                },
                {
                  "id": "item-6b7a0cb1-6378-49aa-a776-2239bff2e468",
                  "content": [
                    {
                      "text": "Elegir la alineación:",
                      "bold": true
                    },
                    {
                      "text": " En la pestaña Inicio, ubica el grupo "
                    },
                    {
                      "text": "Párrafo",
                      "highlight": true
                    },
                    {
                      "text": " y haz clic en la alineación que prefieras: "
                    },
                    {
                      "text": "izquierda",
                      "highlight": true
                    },
                    {
                      "text": ", "
                    },
                    {
                      "text": "centrada",
                      "highlight": true
                    },
                    {
                      "text": ", "
                    },
                    {
                      "text": "derecha",
                      "highlight": true
                    },
                    {
                      "text": " o "
                    },
                    {
                      "text": "justificada",
                      "highlight": true
                    },
                    {
                      "text": "."
                    }
                  ]
                },
                {
                  "id": "item-579fe09f-5dd5-4a7a-932d-c8f0a584419d",
                  "content": [
                    {
                      "text": "Aplicar la alineación:",
                      "bold": true
                    },
                    {
                      "text": " El texto cambiará automáticamente de posición según la opción seleccionada, mejorando la presentación del documento."
                    }
                  ]
                }
              ]
            }
