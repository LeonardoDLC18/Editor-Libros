              "items": [
                {
                  "id": "item-ba73c7fd-07db-4e1b-ae3c-fb5df92b7f9c",
                  "content": [
                    {
                      "text": "Crear la tabla:",
                      "bold": true
                    },
                    {
                      "text": " Abre Excel e ingresa los datos en las columnas "
                    },
                    {
                      "text": "A y B",
                      "bold": true
                    },
                    {
                      "text": "."
                    }
                  ]
                },
                {
                  "id": "item-27d21cfa-e05e-44d1-8a27-ca6600a33c0a",
                  "content": [
                    {
                      "text": "Seleccionar los datos:",
                      "bold": true
                    },
                    {
                      "text": " Selecciona el rango "
                    },
                    {
                      "text": "A1:B6",
                      "highlight": true
                    },
                    {
                      "text": ", incluyendo los encabezados."
                    }
                  ]
                },
                {
                  "id": "item-3615a961-4eb8-42d3-8224-87803d0ae070",
                  "content": [
                    {
                      "text": "Insertar un gráfico de barras:",
                      "bold": true
                    },
                    {
                      "text": " Haz clic en "
                    },
                    {
                      "text": "Insertar → Gráficos y selecciona un gráfico de barras o columnas.",
                      "highlight": true
                    },
                    {
                      "text": " Coloca el título “Botellas recolectadas”."
                    }
                  ]
                },
                {
                  "id": "step-330be50a-4645-4eca-814d-4aee0510ef9f",
                  "content": [
                    {
                      "text": "Crear otros gráficos:",
                      "bold": true
                    },
                    {
                      "text": " Con los mismos datos, inserta un gráfico de líneas y uno circular."
                    }
                  ]
                },
                {
                  "id": "step-df2cf7ea-0b29-49ae-938d-0aeb147d7bc5",
                  "content": [
                    {
                      "text": "Personalizar: ",
                      "bold": true
                    },
                    {
                      "text": "Cambia los colores, agrega títulos y verifica que los datos estén correctamente representados."
                    }
                  ]
                },
                {
                  "id": "step-cfaea57a-d564-4768-b519-fac8867de021",
                  "content": [
                    {
                      "text": "Guardar el archivo:",
                      "bold": true
                    },
                    {
                      "text": " Guarda tu trabajo con el nombre “"
                    },
                    {
                      "text": "Reciclaje_Semanal.xlsx",
                      "highlight": true
                    },
                    {
                      "text": "”."
                    }
                  ]
                }
              ]
            }
