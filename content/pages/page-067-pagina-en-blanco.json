              "items": [
                {
                  "id": "item-e04b4ef8-be16-4a68-96f5-328b825c1956",
                  "content": [
                    {
                      "text": "Crear la tabla:",
                      "bold": true
                    },
                    {
                      "text": " Abre Excel e ingresa los datos desde la celda A1."
                    }
                  ]
                },
                {
                  "id": "item-50fe4528-6ae1-425c-95ae-aaadf88caf91",
                  "content": [
                    {
                      "text": "Seleccionar la información:",
                      "bold": true
                    },
                    {
                      "text": " Selecciona el rango "
                    },
                    {
                      "text": "A1:B6",
                      "highlight": true
                    },
                    {
                      "text": ", incluyendo encabezados y datos."
                    }
                  ]
                },
                {
                  "id": "item-1568c2cf-14f7-4ea4-959b-19d56f3245c4",
                  "content": [
                    {
                      "text": "Insertar el gráfico: ",
                      "bold": true
                    },
                    {
                      "text": "Haz clic en Insertar. En el grupo "
                    },
                    {
                      "text": "Gráficos",
                      "highlight": true
                    },
                    {
                      "text": ", elige Gráfico de columnas y selecciona Columna agrupada."
                    }
                  ]
                },
                {
                  "id": "item-4e13cdd1-b026-4282-91f6-f2740d384274",
                  "content": [
                    {
                      "text": "Personalizar el gráfico:",
                      "bold": true
                    },
                    {
                      "text": " Cambia el título por “"
                    },
                    {
                      "text": "Humedad de las plantas",
                      "highlight": true
                    },
                    {
                      "text": "”. Activa las etiquetas de datos para mostrar los valores sobre las columnas."
                    }
                  ]
                },
                {
                  "id": "item-34ecaa7d-ccda-4e2e-bd16-6f45c0896be7",
                  "content": [
                    {
                      "text": "Interpretar los resultados:",
                      "bold": true
                    },
                    {
                      "text": " Observa el gráfico y responde las preguntas"
                    }
                  ]
                }
              ]
            }
